{% comment %}
  Section: Product Comparison Grid with first item as current product
{% endcomment %}
{% assign comparisons = product.metafields.custom.product_comparison.value %}
{% assign all_products = product.metafields.custom.product_comparison.product %}
{%- assign quick_buy_icon_name = 'quick-buy-' | append: settings.cart_icon | replace: '_', '-' -%}
{% if comparisons %}
<section class="cust-comparison-section">
<div class="container">
  {% if section.settings.section_title != blank %}
    <h3 class="heading h3 cust-comparison-title">{{ section.settings.section_title }}</h3>
  {% endif %}
  <!-- Spec dropdown for mobile -->
  <div class="cust-mobile-spec-filter">
    <select id="spec-filter">
      {% assign specsss = "Speziell geeignet für:custom.specially_suitable_for, Griffhöhe:custom.handle_height, Breite:custom.width, Tiefe:custom.depth, Gewicht:custom.weight, Max. Belastbarkeit:custom.max_load, Faltbar:custom.foldable, Maße zusammengeklappt (L*B*H):custom.folded_dimensions, Radgröße:custom.wheel_size, Sitzhöhe:custom.seat_height, Sitzfläche (L*B):custom.seat_area, Verfügbare Farben:custom.available_colors" | split: "," %}
      {% for spec in specsss %}
        {% assign label = spec | split: ":" | first | strip %}
        <option value="{{ label | handleize }}">{{ label }}</option>
      {% endfor %}
    </select>
  </div>
  <!-- Desktop table -->
  <div class="custom_table cust-desktop-only">
  <table class="cust-comparison-table">
    <thead>
      <tr>
        <th></th>
          <th>
            <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
              {% endif %}
              <div class="cust_product_title">{{ product.title }}</div>
            </a>
            {%- if request.page_type != 'password' and settings.product_add_to_cart and product.available -%}
                {%- if product.variants.size == 1 -%}
                  {%- capture form_id -%}product_form_{{ section.id }}_{{ product.id }}_{% increment product_form_index %}{%- endcapture -%}
                  {%- form 'product', product, is: 'product-form', id: form_id, class: 'product-item__quick-form' -%}
                    <input type="hidden" name="quantity" value="1">
                    <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
                    <button is="loader-button" type="submit" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch">{{ 'collection.product.add_to_cart_short' | t }}</button>
                    <button type="submit" class="product-item__quick-buy-button hidden-no-touch">
                      <span class="visually-hidden">{{ 'collection.product.add_to_cart_short' | t }}</span>
                      {%- render 'icon' with quick_buy_icon_name -%}
                    </button>
                  {%- endform -%}
                {%- else -%}
                  {%- comment -%}
                  IMPLEMENTATION NOTE: Depending on the device we show a different icon or open a different mode (either popover or drawer)
                  {%- endcomment -%}
            
                  <div class="product-item__quick-form">
                    <button is="toggle-button" loader aria-controls="product-{{ section.id }}-{{ product.id }}-drawer" aria-expanded="false" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch hidden-phone">{{ 'collection.product.quick_view' | t }}</button>
                    <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ product.id }}-drawer" aria-expanded="false" class="product-item__quick-buy-button hidden-no-touch hidden-phone">
                      <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
                      {%- render 'icon' with quick_buy_icon_name -%}
                    </button>
            
                    <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ product.id }}-popover" aria-expanded="false" class="product-item__quick-buy-button hidden-tablet-and-up">
                      <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
                      {%- render 'icon' with quick_buy_icon_name -%}
                    </button>
                  </div>
            
                  <quick-buy-popover id="product-{{ section.id }}-{{ product.id }}-popover" href="{{ product.url }}" class="popover popover--quick-buy hidden-tablet-and-up"></quick-buy-popover>
                  <quick-buy-drawer id="product-{{ section.id }}-{{ product.id }}-drawer" href="{{ product.url }}" class="drawer drawer--large drawer--quick-buy hidden-phone"></quick-buy-drawer>
                {%- endif -%}
              {%- endif -%}
          </th>
       
        {% for comparison in comparisons %}
            {% assign p = comparison.product.value %}

          <th>
            <a href="{{ p.url }}" style="text-decoration: none; color: inherit;">
              {% if p.featured_image %}
                <img src="{{ p.featured_image | img_url: 'master' }}" alt="{{ p.title }}">
              {% endif %}
              <div class="cust_product_title">{{ p.title }}</div>
            </a>
            {%- if request.page_type != 'password' and settings.product_add_to_cart and p.available -%}
                {%- if p.variants.size == 1 -%}
                  {%- capture form_id -%}product_form_{{ section.id }}_{{ p.id }}_{% increment product_form_index %}{%- endcapture -%}
                  {%- form 'product', p, is: 'product-form', id: form_id, class: 'product-item__quick-form' -%}
                    <input type="hidden" name="quantity" value="1">
                    <input type="hidden" name="id" value="{{ p.first_available_variant.id }}">
                    <button is="loader-button" type="submit" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch">{{ 'collection.product.add_to_cart_short' | t }}</button>
                    <button type="submit" class="product-item__quick-buy-button hidden-no-touch">
                      <span class="visually-hidden">{{ 'collection.product.add_to_cart_short' | t }}</span>
                      {%- render 'icon' with quick_buy_icon_name -%}
                    </button>
                  {%- endform -%}
                {%- else -%}
                  {%- comment -%}
                  IMPLEMENTATION NOTE: Depending on the device we show a different icon or open a different mode (either popover or drawer)
                  {%- endcomment -%}
            
                  <div class="product-item__quick-form">
                    <button is="toggle-button" loader aria-controls="product-{{ section.id }}-{{ p.id }}-drawer" aria-expanded="false" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch hidden-phone">{{ 'collection.product.quick_view' | t }}</button>
                    <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ p.id }}-drawer" aria-expanded="false" class="product-item__quick-buy-button hidden-no-touch hidden-phone">
                      <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
                      {%- render 'icon' with quick_buy_icon_name -%}
                    </button>
            
                    <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ p.id }}-popover" aria-expanded="false" class="product-item__quick-buy-button hidden-tablet-and-up">
                      <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
                      {%- render 'icon' with quick_buy_icon_name -%}
                    </button>
                  </div>
            
                  <quick-buy-popover id="product-{{ section.id }}-{{ p.id }}-popover" href="{{ p.url }}" class="popover popover--quick-buy hidden-tablet-and-up"></quick-buy-popover>
                  <quick-buy-drawer id="product-{{ section.id }}-{{ p.id }}-drawer" href="{{ p.url }}" class="drawer drawer--large drawer--quick-buy hidden-phone"></quick-buy-drawer>
                {%- endif -%}
              {%- endif -%}
          </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% assign specs = 
        "Price : price,
        Speziell geeignet für:custom.specially_suitable_for,
        Griffhöhe:custom.handle_height,
        Breite:custom.width,
        Tiefe:custom.depth,
        Gewicht:custom.weight,
        Max. Belastbarkeit:custom.max_load,
        Faltbar:custom.foldable,
        Maße zusammengeklappt (L*B*H):custom.folded_dimensions,
        Radgröße:custom.wheel_size,
        Sitzhöhe:custom.seat_height,
        Sitzfläche (L*B):custom.seat_area,
        Verfügbare Farben:custom.available_colors" | split: "," 
      %}

      {% for spec in specs %}
        {% assign parts = spec | split: ":" %}
        {% assign label = parts[0] | strip %}
        {% assign key = parts[1] | strip | split: "." %}
        {% assign namespace = key[0] %}
        {% assign metafield_key = key[1] %}

        <tr>
          <td class="lable_custom"><strong>{{ label }}</strong></td>
          
          {% if label == 'Price' %}
            <td><b>{{ product.price | money }}</b></td>
          {% else %}
            {% assign value = product.metafields[namespace][metafield_key] %}
            {% if label == 'Faltbar' %}
                {% if value.value == true %}
                    <td>✔</td>
                {% else %}
                    <td>✗</td>
                {% endif %}
            {% else %}
            <td>{{ value.value | default: "-" }}</td>
            {% endif %}
          {% endif %}
         
          {% for comparison in comparisons %}
            {% assign p = comparison.product.value %}
            {% assign value = p.metafields[namespace][metafield_key] %}
            {% if label == 'Price' %}
                <td><b>{{ p.price | money }}</b></td>
            {% else %}
                {% if label == 'Faltbar' %}
                    {% if value.value == true %}
                        <td>✔</td>
                    {% else %}
                        <td>✗</td>
                    {% endif %}
                {% else %}
               
                <td>{{ value.value | default: "-" }}</td>
                {% endif %}
            {% endif %}
            
            
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <!-- Mobile Grid -->
  <div class="cust-mobile-grid cust-mobile-only">
    <div class="cust-product-card">
        <div class="image_spec">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: '300x' }}" alt="{{ product.title }}">
        {% endif %}
        <div class="cust_product_title">{{ product.title }}</div>
        <div class="cust-product-specs">
          {% for spec in specsss %}
            {% assign parts = spec | split: ":" %}
            {% assign label = parts[0] | strip %}
            {% assign key = parts[1] | strip | split: "." %}
            {% assign namespace = key[0] %}
            {% assign metafield_key = key[1] %}
            
            <div class="cust-spec-row {% if forloop.first %}active{% endif %}" data-spec="{{ label | handleize }}">
                {% assign val = product.metafields[namespace][metafield_key].value %}
                {% if label == 'Faltbar' %}
                    {% if val == true %}
                        <td>✔</td>
                    {% else %}
                        <td>✗</td>
                    {% endif %}
                {% else %}
                    
                    {{ val | default: '-' }}
                {% endif %}
               
             
            </div>
          {% endfor %}
        </div>
        </div>
        {%- if request.page_type != 'password' and settings.product_add_to_cart and product.available -%}
            {%- if product.variants.size == 1 -%}
              {%- capture form_id -%}product_form_{{ section.id }}_{{ product.id }}_{% increment product_form_index %}{%- endcapture -%}
              {%- form 'product', product, is: 'product-form', id: form_id, class: 'product-item__quick-form' -%}
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
                <button is="loader-button" type="submit" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch">{{ 'collection.product.add_to_cart_short' | t }}</button>
                <button type="submit" class="product-item__quick-buy-button hidden-no-touch">
                  <span class="visually-hidden">{{ 'collection.product.add_to_cart_short' | t }}</span>
                  {%- render 'icon' with quick_buy_icon_name -%}
                </button>
              {%- endform -%}
            {%- else -%}
              {%- comment -%}
              IMPLEMENTATION NOTE: Depending on the device we show a different icon or open a different mode (either popover or drawer)
              {%- endcomment -%}
        
              <div class="product-item__quick-form">
                <button is="toggle-button" loader aria-controls="product-{{ section.id }}-{{ product.id }}-drawer" aria-expanded="false" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch hidden-phone">{{ 'collection.product.quick_view' | t }}</button>
                <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ product.id }}-drawer" aria-expanded="false" class="product-item__quick-buy-button hidden-no-touch hidden-phone">
                  <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
                  {%- render 'icon' with quick_buy_icon_name -%}
                </button>
        
                <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ product.id }}-popover" aria-expanded="false" class="product-item__quick-buy-button hidden-tablet-and-up">
                  <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
                  {%- render 'icon' with quick_buy_icon_name -%}
                </button>
              </div>
        
              <quick-buy-popover id="product-{{ section.id }}-{{ product.id }}-popover" href="{{ product.url }}" class="popover popover--quick-buy hidden-tablet-and-up"></quick-buy-popover>
              <quick-buy-drawer id="product-{{ section.id }}-{{ product.id }}-drawer" href="{{ product.url }}" class="drawer drawer--large drawer--quick-buy hidden-phone"></quick-buy-drawer>
            {%- endif -%}
          {%- endif -%}
        <div class="cust_product_price"><b>{{ product.price | money }}</b></div>
      </div>
    {% for comparison in comparisons %}
        {% assign prod = comparison.product.value %}
      <div class="cust-product-card">
        <div class="image_spec">
        {% if prod.featured_image %}
          <img src="{{ prod.featured_image | img_url: '300x' }}" alt="{{ prod.title }}">
        {% endif %}
        <div class="cust_product_title">{{ prod.title }}</div>
        <div class="cust-product-specs">
          {% for spec in specsss %}
            {% assign parts = spec | split: ":" %}
            {% assign label = parts[0] | strip %}
            {% assign key = parts[1] | strip | split: "." %}
            {% assign namespace = key[0] %}
            {% assign metafield_key = key[1] %}
            
            <div class="cust-spec-row {% if forloop.first %}active{% endif %}" data-spec="{{ label | handleize }}">
            
                    {% assign val = prod.metafields[namespace][metafield_key].value %}
                    {% if label == 'Faltbar' %}
                        {% if val == true %}
                            <td>✔</td>
                        {% else %}
                            <td>✗</td>
                        {% endif %}
                    {% else %}
                    {{ val | default: '-' }}
                    {% endif %}
               
             
            </div>
          {% endfor %}
        </div>
    </div>
    {%- if request.page_type != 'password' and settings.product_add_to_cart and p.available -%}
        {%- if prod.variants.size == 1 -%}
          {%- capture form_id -%}product_form_{{ section.id }}_{{ prod.id }}_{% increment product_form_index %}{%- endcapture -%}
          {%- form 'product', prod, is: 'product-form', id: form_id, class: 'product-item__quick-form' -%}
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="id" value="{{ prod.first_available_variant.id }}">
            <button is="loader-button" type="submit" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch">{{ 'collection.product.add_to_cart_short' | t }}</button>
            <button type="submit" class="product-item__quick-buy-button hidden-no-touch">
              <span class="visually-hidden">{{ 'collection.product.add_to_cart_short' | t }}</span>
              {%- render 'icon' with quick_buy_icon_name -%}
            </button>
          {%- endform -%}
        {%- else -%}
          {%- comment -%}
          IMPLEMENTATION NOTE: Depending on the device we show a different icon or open a different mode (either popover or drawer)
          {%- endcomment -%}
    
          <div class="product-item__quick-form">
            <button is="toggle-button" loader aria-controls="product-{{ section.id }}-{{ prod.id }}-drawer" aria-expanded="false" class="button button--outline button--text button--full {% if section.settings.desktop_products_per_row >= 5 %}button--small{% endif %} hidden-touch hidden-phone">{{ 'collection.product.quick_view' | t }}</button>
            <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ prod.id }}-drawer" aria-expanded="false" class="product-item__quick-buy-button hidden-no-touch hidden-phone">
              <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
              {%- render 'icon' with quick_buy_icon_name -%}
            </button>
    
            <button is="toggle-button" aria-controls="product-{{ section.id }}-{{ prod.id }}-popover" aria-expanded="false" class="product-item__quick-buy-button hidden-tablet-and-up">
              <span class="visually-hidden">{{ 'collection.product.quick_view' | t }}</span>
              {%- render 'icon' with quick_buy_icon_name -%}
            </button>
          </div>
    
          <quick-buy-popover id="product-{{ section.id }}-{{ prod.id }}-popover" href="{{ prod.url }}" class="popover popover--quick-buy hidden-tablet-and-up"></quick-buy-popover>
          <quick-buy-drawer id="product-{{ section.id }}-{{ prod.id }}-drawer" href="{{ prod.url }}" class="drawer drawer--large drawer--quick-buy hidden-phone"></quick-buy-drawer>
        {%- endif -%}
      {%- endif -%}
        <div class="cust_product_price"><b>{{ prod.price | money }}</b></div>
      </div>
    {% endfor %}
  </div>
  </div>

</section>
{% endif %}


{% schema %}
{
  "name": "Product Comparison",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Produktvergleich"
    }
  ],
  "presets": [
    {
      "name": "Product Comparison Table"
    }
  ]
}
{% endschema %}
{% stylesheet %}
.cust-comparison-scroll-wrapper {
  overflow-x: auto;
  width: 100%;
}
table.cust-comparison-table img {
    aspect-ratio: 1 / 1;
    display: block; margin: 0 auto;
}
.cust_product_title{
    line-height: 1.2;
    padding-top: 15px;
}
.cust-comparison-table {
  border-collapse: collapse;
  min-width: 800px; /* Ensures table is wider than viewport to enable scroll */
}

.cust-comparison-table th,
.cust-comparison-table td {
  padding: 10px;
  text-align: left;
  vertical-align: top;
  background: white;
  min-width: 230px; /* optional: ensures consistent column width */
  width: 230px;
}

/* Sticky first column: label column */
.cust-comparison-table td:first-child,
.cust-comparison-table th:first-child {
    position: sticky;
    left: 0;
    background: #fff;
    min-width: 300px;
    border-color: #fff;
    z-index: 1;
}

/* Sticky default product (second column) */
.cust-comparison-table td:nth-child(2),
.cust-comparison-table th:nth-child(2) {
    position: sticky;
    left: 300px;
    background: #fff;
    border-color: #fff;
    z-index: 1;
}

/* Header row no borders */
.cust-comparison-table thead tr th {
  border: none;
  background-color: transparent;
}

/* Only bottom border in tbody */
.cust-comparison-table tbody tr {
  border-bottom: 1px solid #ccc;
}

.cust-comparison-table tbody td {
  border: none;
  line-height: 1;
}

.cust-comparison-title {
  text-align: center;
}
.custom_table{
    overflow-x: scroll;
    overflow-y: visible;
    width: 100%;
}
a .cust-desktop-only { display: block; }
.cust-mobile-only { display: none; }
#spec-filter {
  width: 100%;
  max-width: 300px;
  padding: 10px 14px;
  font-size: 16px;
  color: #333;
  background-color: #fff;
  border: 1px solid #ccc;
  border-radius: 8px;
  appearance: none;
  background-image: url('data:image/svg+xml;utf8,<svg fill="%23666" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 10l5 5 5-5z"/></svg>');
  background-repeat: no-repeat;
  background-position: right 12px center;
  background-size: 20px;
}

@media screen and (max-width: 768px) {
  .cust-desktop-only { display: none; }
  .cust-mobile-only { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
}

.cust-product-card {
  position: relative;
  border: 1px solid #ccc;
    padding: 5px;
  border-radius: 8px;
  display: grid;
    align-content: space-between;
}


.image_spec{
   
}
.cust-product-title, .cust_product_price { margin: 0.5rem 0; }
.cust-product-specs .cust-spec-row { display:none;margin-bottom: 0.4rem;font-weight: 500;line-height: 1.2;}
.cust-product-specs .cust-spec-row.active{display:block;}
.cust-mobile-spec-filter {
  display: none;
  margin-bottom: 1rem;
}
.cust-mobile-grid.cust-mobile-only {
    text-align: center;
}
.cust-product-card .cust_product_title {
    margin-bottom: 6px;
    font-weight: 600;
}

.cust-comparison-table .product-item__quick-form {
    position: relative;
    visibility: visible;
    opacity: 1;
    font-size: 14px;
    padding-inline: 0;
    width: fit-content;
}

.cust-comparison-table .product-item__quick-form * {
    line-height: 2.2;
}
.cust-product-card .product-item__quick-buy-button {
    bottom: unset !important;
}
.cust-product-card .product-item__quick-form{
    top: 0;
}
@media screen and (max-width: 768px) {
  .cust-mobile-spec-filter { display: block; }
}
{% endstylesheet %}

<script>
    document.addEventListener('DOMContentLoaded', function () {
      const dropdown = document.getElementById('spec-filter');
      dropdown?.addEventListener('change', function () {
        const selected = this.value;
        const rows = document.querySelectorAll('.cust-spec-row');
        rows.forEach(row => {
            if (selected === 'all' || row.dataset.spec === selected) {
                row.classList.add('active');
              } else {
                row.classList.remove('active');
              }
        });
      });
    });
    </script>